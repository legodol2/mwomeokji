{
  "expo": {
    "name": "뭐먹고",
    "slug": "mwomeokji",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mwomeokji.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "사는 지역(시·군·구)을 알아내 그 지역 기준으로 장보기 가격을 계산하는 데만 씁니다. 위치는 기기 안에만 저장되고 어디에도 보내지 않습니다.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "7ZK5H7LL83",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mwomeokji.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "primaryColor": "#FB6545",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "사는 지역(시·군·구)을 알아내 그 지역 기준으로 장보기 가격을 계산하는 데만 씁니다. 위치는 기기 안에만 저장되고 어디에도 보내지 않습니다."
        }
      ],
      "./plugins/withSceneDelegate",
      "./plugins/withLocalNotificationsOnly"
    ]
  }
}
